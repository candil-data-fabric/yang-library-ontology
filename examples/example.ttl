@prefix yl: <https://w3id.org/yang/library#> .
@prefix ys: <https://w3id.org/yang/server#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@base <https://network-data-catalog.org/> .

########################################
# NETCONF Server
########################################

<NetconfServer/srl> a ys:NetconfServer ;
    ys:socketAddress <NetconfServer/srl/SocketAddress> ;
    ys:serverAccount <NetconfServer/srl/ServerAccount> ;
    ys:hostKeyVerification "false";
    yl:yangLibrary <NetconfServer/srl/YangLibrary/1k19sk2x1k19sk3yk4> .

<NetconfServer/srl/SocketAddress> a observable:SocketAddress ;
    observable:addressValue "172.100.100.11:830" .

<NetconfServer/srl/ServerAccount> a ys:ServerAccount ;
    ys:username "admin" ;
    core:hasFacet <NetconfServer/srl/ServerAccount/authentication> .

<NetconfServer/srl/ServerAccount/authentication> a observable:AccountAuthenticationFacet ;
    observable:password "NokiaSrl1!" ;
    observable:passwordType "plain-text" .

########################################
# YANG Library
########################################

<NetconfServer/srl/YangLibrary/1k19sk2x1k19sk3yk4> a yl:YangLibrary ;
    yl:yangLibraryId "1k19sk2x1k19sk3yk4" ;
    yl:moduleSet <NetconfServer/srl/ModuleSet/nokia> ;
    yl:schema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Datastore/operational> a ys:CandidateDatastore ;
    ys:server <NetconfServer/srl> ;
    yl:implementsSchema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Datastore/operational> a ys:IntendedDatastore ;
    ys:server <NetconfServer/srl> ;
    yl:implementsSchema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Datastore/operational> a ys:OperationalDatastore ;
    ys:server <NetconfServer/srl> ;
    yl:implementsSchema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Datastore/running> a ys:RunningDatastore ;
    ys:server <NetconfServer/srl> ;
    yl:implementsSchema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Datastore/operational> a ys:StartupDatastore ;
    ys:server <NetconfServer/srl> ;
    yl:implementsSchema <NetconfServer/srl/Schema/nokia> .

<NetconfServer/srl/Schema/nokia> a yl:Schema ;
    yl:schemaId "nokia" ;
    yl:containsModuleSet <NetconfServer/srl/ModuleSet/nokia> .

<NetconfServer/srl/ModuleSet/nokia> a yl:ModuleSet ;
    yl:moduleSetId "nokia" ;
    ys:moduleImport <NetconfServer/srl/ModuleSet/nokia/ModuleImport/iana-if-type/2014-05-08> ,
                    <NetconfServer/srl/ModuleSet/nokia/ModuleImport/openconfig-aft/2023-09-26> ;
    ys:moduleImplementation <NetconfServer/srl/ModuleSet/nokia/ModuleImplementation/openconfig-interfaces/2023-11-06> ,
                            <NetconfServer/srl/ModuleSet/nokia/ModuleImplementation/openconfig-srl-deviations/2024-10-31> .

########################################
# Imported YANG Modules
########################################

<NetconfServer/srl/ModuleSet/nokia/ModuleImport/iana-if-type/2014-05-08> a yl:ModuleImport ;
    yl:location "file:///opt/srlinux/models/iana/iana-if-type.yang"^^xsd:anyURI ;
    yl:importedModule <Module/iana-if-type/2014-05-08> .

<Module/iana-if-type/2014-05-08> a yl:Module ;
    yl:moduleName "iana-if-type" ;
    yl:revisionDate "2014-05-08"^^xsd:date ;
    yl:namespace "urn:ietf:params:xml:ns:yang:iana-if-type"^^xsd:anyURI ;
    yl:includesSubmodule <Module/openconfig-aft-common/2023-09-26> ,
                         <Module/openconfig-aft-ethernet/2023-09-26> .

<NetconfServer/srl/ModuleSet/nokia/ModuleImport/openconfig-aft/2023-09-26> a yl:ModuleImport ;
    yl:location "file:///opt/srlinux/models/openconfig/aft/openconfig-aft.yang"^^xsd:anyURI ;
    yl:importedModule <Module/openconfig-aft/2023-09-26> .

<Module/openconfig-aft/2023-09-26> a yl:Module ;
    yl:moduleName "openconfig-aft" ;
    yl:revisionDate "2023-09-26"^^xsd:date ;
    yl:namespace "http://openconfig.net/yang/aft"^^xsd:anyURI ;
    yl:includesSubmodule <Module/openconfig-aft-common/2023-09-26> ,
                         <Module/openconfig-aft-ethernet/2023-09-26> .

<Module/openconfig-aft-common/2023-09-26> a yl:Submodule ;
    yl:moduleName "openconfig-aft-common" ;
    yl:revisionDate "2023-09-26"^^xsd:date .

<Module/openconfig-aft-ethernet/2023-09-26> a yl:Submodule ;
    yl:moduleName "openconfig-aft-ethernet" ;
    yl:revisionDate "2023-09-26"^^xsd:date .

########################################
# Implemented YANG Modules
########################################

<NetconfServer/srl/ModuleSet/nokia/ModuleImplementation/openconfig-interfaces/2023-11-06> a yl:ModuleImplementation ;
    yl:implementsModule <Module/openconfig-interfaces/2023-11-06> ;
    yl:location "file:///opt/srlinux/models/openconfig/interfaces/openconfig-interfaces.yang"^^xsd:anyURI .

<Module/openconfig-interfaces/2023-11-06> a yl:Module ;
    yl:moduleName "openconfig-interfaces" ;
    yl:revisionDate "2023-11-06"^^xsd:date ;
    yl:namespace "http://openconfig.net/yang/interfaces"^^xsd:anyURI .

<NetconfServer/srl/ModuleSet/nokia/ModuleImplementation/openconfig-srl-deviations/2024-10-31> a yl:ModuleImplementation ;
    yl:implementsModule <Module/openconfig-srl-deviations/2024-10-31> ;
    yl:location "file:///opt/srlinux/deviations/openconfig/openconfig-srl-deviations.yang"^^xsd:anyURI .
    yl:usesFeature <Module/openconfig-srl-deviations/2019-04-16/Feature/ipv4-unnumbered> ,
                   <Module/openconfig-srl-deviations/2019-04-16/Feature/interface-evpn-internal-tags> .

<Module/openconfig-srl-deviations/2019-04-16/Feature/ipv4-unnumbered> a yl:Feature ;
    yl:featureName "ipv4-unnumbered" .

<Module/openconfig-srl-deviations/2019-04-16/Feature/interface-evpn-internal-tags> a yl:Feature ;
    yl:featureName "interface-evpn-internal-tags" .

<Module/openconfig-srl-deviations/2024-10-31> a yl:Module ;
    yl:moduleName "openconfig-srl-deviations" ;
    yl:revisionDate "2024-10-31"^^xsd:date ;
    yl:namespace "urn:nokia.com:srlinux:openconfig:openconfig-srl-deviations"^^xsd:anyURI ;
    yl:deviatesModule <Module/openconfig-interfaces/2023-11-06> .

