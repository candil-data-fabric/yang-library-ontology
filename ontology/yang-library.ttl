@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yl: <https://w3id.org/yang/library#> .
@prefix ys: <https://w3id.org/yang/server#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty .

owl:priorVersion a owl:AnnotationProperty .

owl:versionIRI a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

schema:codeRepository a owl:AnnotationProperty .

yl:augmentedByModule a owl:ObjectProperty ;
    rdfs:label "augmented by module" ;
    rdfs:domain yl:Module ;
    rdfs:range yl:Module ;
    rdfs:subPropertyOf yl:moduleDependency .

yl:containsModuleSet a owl:ObjectProperty ;
    rdfs:label "contains module set" ;
    rdfs:domain yl:Schema ;
    rdfs:range yl:ModuleSet .

yl:deviatedByModule a owl:ObjectProperty ;
    rdfs:label "deviated by module" ;
    rdfs:domain yl:Module ;
    rdfs:range yl:Module ;
    rdfs:subPropertyOf yl:moduleDependency .

yl:featureName a owl:DatatypeProperty ;
    rdfs:label "feature name" ;
    rdfs:domain yl:Feature ;
    rdfs:range xsd:string .

yl:implementedModule a owl:ObjectProperty ;
    rdfs:label "implemented module" ;
    rdfs:domain yl:ModuleImplementation ;
    rdfs:range yl:Module .

yl:implementsSchema a owl:ObjectProperty ;
    rdfs:label "implements schema" ;
    rdfs:domain ys:Datastore ;
    rdfs:range yl:Schema .

yl:importedModule a owl:ObjectProperty ;
    rdfs:label "imported module" ;
    rdfs:domain yl:ModuleImport ;
    rdfs:range yl:Module .

yl:importsModule a owl:ObjectProperty ;
    rdfs:label "imports module" ;
    rdfs:domain yl:Module ;
    rdfs:range yl:Module ;
    rdfs:subPropertyOf yl:moduleDependency .

yl:includesSubmodule a owl:ObjectProperty ;
    rdfs:label "includes submodule" ;
    rdfs:domain yl:Module ;
    rdfs:range yl:Submodule ;
    rdfs:subPropertyOf yl:moduleDependency .

yl:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:range xsd:anyURI .

yl:moduleImplementation a owl:ObjectProperty ;
    rdfs:label "module implementation" ;
    rdfs:domain yl:ModuleSet ;
    rdfs:range yl:ModuleImplementation .

yl:moduleImport a owl:ObjectProperty ;
    rdfs:label "module import" ;
    rdfs:domain yl:ModuleSet ;
    rdfs:range yl:ModuleImport .

yl:moduleName a owl:DatatypeProperty ;
    rdfs:label "module name" ;
    rdfs:domain yl:Module ;
    rdfs:range xsd:string .

yl:moduleSet a owl:ObjectProperty ;
    rdfs:label "module set" ;
    rdfs:domain yl:YangLibrary ;
    rdfs:range yl:ModuleSet .

yl:moduleSetId a owl:DatatypeProperty ;
    rdfs:label "module set id" ;
    rdfs:domain yl:ModuleSet ;
    rdfs:range xsd:string .

yl:namespace a owl:DatatypeProperty ;
    rdfs:label "namespace" ;
    rdfs:domain yl:Module ;
    rdfs:range xsd:anyURI .

yl:revisionDate a owl:DatatypeProperty ;
    rdfs:label "revision date" ;
    rdfs:domain yl:Module ;
    rdfs:range xsd:date .

yl:schema a owl:ObjectProperty ;
    rdfs:label "schema" ;
    rdfs:domain yl:YangLibrary ;
    rdfs:range yl:Schema .

yl:schemaId a owl:DatatypeProperty ;
    rdfs:label "schema id" ;
    rdfs:domain yl:Schema ;
    rdfs:range xsd:string .

yl:usesFeature a owl:ObjectProperty ;
    rdfs:label "uses feature" ;
    rdfs:domain yl:ModuleImplementation ;
    rdfs:range yl:Feature .

yl:yangLibrary a owl:ObjectProperty ;
    rdfs:label "yang library" ;
    rdfs:domain ys:YangServer ;
    rdfs:range yl:YangLibrary .

yl:yangLibraryId a owl:DatatypeProperty ;
    rdfs:label "yang library id" ;
    rdfs:domain yl:YangLibrary ;
    rdfs:range xsd:string .

ys:NetconfCapability a owl:Class ;
    rdfs:label "Netconf Capability" ;
    rdfs:subClassOf yl:Feature .

ys:server a owl:ObjectProperty ;
    rdfs:label "server" .

yl: a owl:Ontology ;
    dcterms:created "2025-05-03"^^xsd:date ;
    dcterms:creator "Ignacio Dominguez Martinez-Casanueva (https://orcid.org/0000-0002-8573-127X)" ;
    dcterms:description "An ontology for representing YANG Library" ;
    dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0> ;
    dcterms:publisher <https://github.com/candil-data-fabric> ;
    dcterms:title "YANG Library Ontology" ;
    vann:preferredNamespacePrefix "yl" ;
    vann:preferredNamespaceUri yl: ;
    rdfs:seeAlso <https://datatracker.ietf.org/doc/rfc8525/> ;
    owl:priorVersion <https://w3id.org/yang/library> ;
    owl:versionIRI <https://w3id.org/yang/library> ;
    owl:versionInfo "1.2.0" ;
    schema:codeRepository "https://github.com/candil-data-fabric/yang-library-ontology"^^xsd:anyURI ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

yl:Submodule a owl:Class ;
    rdfs:label "Submodule" ;
    rdfs:subClassOf yl:Module .

ys:Datastore a owl:Class ;
    rdfs:label "Datastore" .

ys:YangServer a owl:Class ;
    rdfs:label "Yang Server" .

yl:ModuleImport a owl:Class ;
    rdfs:label "Module Import" .

yl:Feature a owl:Class ;
    rdfs:label "Feature" .

yl:ModuleImplementation a owl:Class ;
    rdfs:label "Module Implementation" .

yl:Schema a owl:Class ;
    rdfs:label "Schema" .

yl:YangLibrary a owl:Class ;
    rdfs:label "Yang Library" .

yl:moduleDependency a owl:ObjectProperty ;
    rdfs:label "module dependency" .

yl:ModuleSet a owl:Class ;
    rdfs:label "Module Set" .

yl:Module a owl:Class ;
    rdfs:label "Module" .

